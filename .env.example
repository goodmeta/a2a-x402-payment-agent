# x402 Payment Agent Configuration

# Private key of the wallet that will pay for API calls
# Must hold USDC on the target chain (e.g., Base Sepolia for testnet)
AGENT_PRIVATE_KEY=0x...

# Chain to use for payments
# base-sepolia (testnet) or base (mainnet)
CHAIN=base-sepolia

# x402 facilitator URL (handles permit verification + settlement)
# Options:
#   https://x402.coinbase.com        (Coinbase - Base mainnet)
#   https://x402.stablecoin.xyz      (SBC - Base mainnet/sepolia)
FACILITATOR_URL=https://x402.stablecoin.xyz

# Server port
PORT=3000
